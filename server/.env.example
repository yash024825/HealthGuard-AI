PORT=5000
MONGO_URI=mongodb://localhost:27017/healthguard-ai
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000

# Google Sign-In
# Create a Web application OAuth client at https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 to "Authorized JavaScript origins"
# Use the same Client ID here and as VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
